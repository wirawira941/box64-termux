@@ -5493,4 +5494,19 @@ EXPORT char* secure_getenv(const char* name)
     freeMy();       \
     return;     // do not unload...
 
+#ifdef ANDROID
+// bionic has no gettext implementation; the engine only needs untranslated strings.
+EXPORT void* my___newlocale(int mask, const char* name, void* base)
+{
+    // glibc's libstdc++ passes (1 << LC_ALL) == 0x40, which glibc tolerates but bionic rejects.
+    if (mask & (1 << LC_ALL))
+        mask = (mask & LC_ALL_MASK) | LC_ALL_MASK;
+    return (void*)newlocale(mask, name, (locale_t)base);
+}
+EXPORT char* my_gettext(const char* msgid) { return (char*)msgid; }
+EXPORT char* my_dgettext(const char* domain, const char* msgid) { (void)domain; return (char*)msgid; }
+EXPORT char* my_bindtextdomain(const char* domain, const char* dirname) { (void)domain; return (char*)dirname; }
+EXPORT char* my_bind_textdomain_codeset(const char* domain, const char* codeset) { (void)domain; return (char*)codeset; }
+#endif
+
 #include "wrappedlib_init.h"
